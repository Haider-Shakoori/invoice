APP_NAME="Invoice Drafts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://invoice.test
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

CENTRAL_DOMAIN=invoice.test
TENANT_BASE_DOMAIN=invoice.test

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invoice_central
DB_USERNAME=root
DB_PASSWORD=
TENANT_DB_PREFIX=invoice_tenant_
TENANT_DB_PROVISIONER=native
CPANEL_UAPI_BINARY=/usr/bin/uapi
CPANEL_MYSQL_USER=
CPANEL_UAPI_TIMEOUT_SECONDS=30

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

INVOICE_TRIAL_DAYS=7
INVOICE_SETUP_PRICE_AFN=2000
INVOICE_FIRST_YEAR_PRICE_AFN=3000
INVOICE_RENEWAL_PRICE_AFN=3000
INVOICE_PAYMENT_DUE_DAYS=7
INVOICE_GRACE_DAYS=0

PDF_CHROMIUM_BINARY=
PDF_TIMEOUT_SECONDS=30
PDF_FONT_FAMILY="Inter, DejaVu Sans, Arial, sans-serif"
PDF_RTL_FONT_FAMILY="Noto Naskh Arabic, Noto Sans Arabic, DejaVu Sans, Arial, sans-serif"

MYSQLDUMP_BINARY=
BACKUP_TIMEOUT_SECONDS=900

CENTRAL_ADMIN_NAME="Head Operator"
CENTRAL_ADMIN_EMAIL=
CENTRAL_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=debug
